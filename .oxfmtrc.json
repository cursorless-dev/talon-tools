{
    "$schema": "./node_modules/oxfmt/configuration_schema.json",
    "ignorePatterns": ["dist"],
    "tabWidth": 4,
    "printWidth": 80,
    "sortPackageJson": false,
    "sortImports": {
        "newlinesBetween": false,
        "partitionByNewline": true
    },

    "overrides": [
        {
            "files": ["*.{yaml,md}"],
            "options": {
                "tabWidth": 2
            }
        }
    ]
}
